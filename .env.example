# WarcraftLogs API credentials
# Create a client at: https://www.warcraftlogs.com/api/clients
# Set redirect URI to: http://localhost:3456/callback
WCL_CLIENT_ID=your_client_id_here
WCL_CLIENT_SECRET=your_client_secret_here

# Your character name (used to auto-select you from a log)
WCL_CHARACTER_NAME=YourCharacterName

# Optional: ignore everything after this many deaths in a pull, like WarcraftLogs'
# "ignore after X deaths" setting. Leave blank for off; pages can override it.
WCL_DEATH_CUTOFF=

# Port (must match the redirect URI registered with WarcraftLogs)
PORT=3456
